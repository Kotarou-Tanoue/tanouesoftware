@startuml ログインする
    title ログインする

    actor "利用者" as a1
    boundary "メニュー" as b1
    boundary "login.html" as b2
    boundary "LINE認証画面" as b3
    control "AuthView" as c1
    control "LINE認証サービス" as c2
    entity "UserAuth" as e1
    entity "User" as e2
    control "IndexView" as c3
    boundary "index.html" as b4

    == 1. ログイン画面の表示 ==
    a1 -> b1 : ログインリンクをクリック
    b1 -> c1 : GET /login
    c1 -> b2 : login.htmlを表示

    alt 「ホームに戻る」押下時の処理
        a1 -> b2 : ホームに戻るをクリック
        b1 -> c3 : GET /index
        c3 -> b4 : 表示
        note over b4 : ユースケース終了
    end

    == 2. LINE認証 ==
    a1 -> b2 : LINEログインボタンをクリック
    b2 -> c2 : POST
    c2 -> b3 : LINE認証画面へ遷移
    a1 -> b3 : ログイン & 同意
    b3 -> c2 : 認証リクエスト
    c2 -> c1 : 認証結果（ユーザー情報）を通知
    alt 認証失敗
        c1 -> b2 : エラーメッセージを表示
    end
    == 3. アプリ側でのログイン・画面遷移 ==
    c1 -> e1 : ユーザー認証情報の取得
    alt ユーザー認証情報が取得できない場合
        c1 -> e2 : ユーザー新規登録
        e2 --> c1 : 登録完了
        c1 -> e1 : ユーザー認証情報新規登録

    end
    e1 --> c1 : ユーザー認証情報
    c1 -> e2 : 認証情報が一致したユーザーを取得
    e2 --> c1 : ユーザー情報

    c1 -> c1 : sessionにuser_idを保存

    c1 -> c3 : リダイレクト
    c3 -> b4 : index.htmlを表示
    b4 -> a1 : ログイン後のトップ画面を表示

@enduml


@startuml ログアウトする
    title ログアウトする

    actor "利用者" as a1
    boundary "メニュー" as b1
    boundary "logout.html" as b2
    control "LogoutView" as c1
    control "IndexView" as c2
    boundary "index.html" as b3

    a1 -> b1 : ログアウトリンクをクリック
    b1 -> c1 : GET /logout
    c1 -> b2 : 表示

    alt キャンセルをクリックした場合
        a1 -> b2 : キャンセルをクリック
        b2 -> c2 : GET /index
        c2 -> b3 : 表示
        note over b3 : ユースケース終了
    else ログアウトをクリックした場合
        a1 -> b2 : ログアウトをクリック
        b2 -> c1 : POST

        c1 -> c1 : ユーザーのセッション情報をクリア\n(session.clear())

        c1 -> c2 : リダイレクト
        c2 -> b3 : 表示
    end

@enduml


@startuml 建物情報を入力する
    title 建物情報を入力する

    actor "利用者" as a1
    boundary "メニュー / ホーム" as b1
    boundary "analysis_input_building.html" as b2
    control "AnalysisInputView" as c1
    entity "Building" as e1
    boundary "analysis_input_damage.html" as b3
    control "IndexView" as c2
    boundary "index.html" as b4


    == 1. 建物入力画面の表示と初期判定 ==
    a1 -> b1 : 被害状況分析リンクをクリック
    b1 -> c1 : GET /building
    c1 -> c1 : ログイン状態を確認

    alt ログインしていない
        c1 -> b2 : 分析建物入力画面を表示
    else ログインしている
        c1 -> e1 : ユーザーが登録している建物データを取得
        e1 --> c1 : 建物データ
        c1 -> b2 : 分析建物入力画面を表示

        b2 -> b2 : 新規入力した建物情報を保存できるようにする
        alt 建物データがある
            b2 -> b2 : 登録済みの建物を選択できるようにする
        end
    end
    b2 --> a1

    == 2. 画面内での動的制御 ==
    alt 「新しい建物を入力」が選択された
        a1 -> b2 : 「新しい建物を入力」を選択
        b2 -> b2 : 新規入力欄を表示する
    else 登録済みの建物が選択された
        a1 -> b2 : 登録済みの建物（リスト）を選択
        b2 -> b2 : 新規入力欄を非表示にする
    end

    == 3. 「次へ」押下時の入力チェックと分岐処理 ==
    a1 -> b2 : 分析する建物の情報を入力し「次へ」をクリック
    b2 -> c1 : POST
    c1 -> c1 : 入力をチェックする
    alt 登録済みの建物を選択した場合
        c1 -> c1 : sessionにbuilding_idを保存
        c1 -> b3 : 表示
    else 新しい建物を入力した場合
        alt 未入力・未選択がある場合
            c1 -> b2 : 「入力 / 選択してください」メッセージ表示
        else 入力が正しい場合
            alt ログインしている場合
                alt 建物名が同じユーザの登録済みの建物と重複している場合
                    c1 -> b2 : 「すでに登録している建物です」メッセージ表示
                else 重複していない場合
                    c1 -> e1 : 建物情報を保存
                    e1 --> c1 : 保存完了 / 建物データ
                    c1 -> c1 : sessionにbuilding_idを保存
                    c1 -> b3 : 表示
                    note over b3 : ユースケース\n「被害状況を入力する」へ
                end
            else ログインしていない場合
                c1 --> b2 : 成功レスポンスを返す
                b2 -> b2 : 入力内容をsessionStorageに保存
                b2 -> b3 : 遷移
                note over b3 : ユースケース\n「被害状況を入力する」へ
            end
        end
    end

    == 4. 「戻る」押下時の処理 ==
    a1 -> b2 : 「戻る」をクリック
    b2 -> c2 : GET
    c2 -> b4 : 表示
    note over b4 : ユースケース終了

@enduml


@startuml 被害状況を入力する_1
    title 被害状況を入力する1 (情報入力)

    actor "利用者" as a1
    boundary "analysis_input_damage.html" as b1
    boundary "写真ライブラリ画面" as b2
    boundary "カメラ画面" as b3
    control "AnalysisInputView" as c1
    boundary "analysis_input_building.html" as b4
    control "AnalysisView" as c3

    == 1. 写真の取得処理 ==
    note over b1 : ユースケース\n「建物情報を入力する」から
    alt 写真を選択する場合
        a1 -> b1 : 被害写真に関する情報を入力し、\nファイルを選択ボタンをクリック
        b1 -> b2 : 端末の写真ライブラリを開く

        alt 写真ライブラリへのアクセスが拒否された
            b2 -> b1 : エラーメッセージを表示
        else アクセス許可
            a1 -> b2 : 写真を選択
            b2 -> b1 : 写真情報を返す
        end

    else 写真を撮影する場合
        a1 -> b1 : 「写真を撮影」をクリック
        b1 -> b3 : カメラを起動

        alt カメラへのアクセスが拒否された
            b3 -> b1 : エラーメッセージを表示
        else アクセス許可
            a1 -> b3 : カメラで被害写真を撮影
            b3 -> b1 : 写真情報を返す
        end
    end

    == 2. 「この被害情報を追加」押下時のチェックとリスト追加 ==
    a1 -> b1 : 「この被害情報を追加」ボタンをクリック
    b1 -> c1 : POST /damage/add (またはフロントでの入力検証)

    == [チェック1] 未入力・未選択チェック ==
    c1 -> c1 : 未入力・未選択チェック
    alt 未入力・未選択あり
        c1 -> b1 : 催促メッセージ（エラーメッセージ）を表示
    else 未入力・未選択なし

        == [チェック2] 写真の未登録チェック ==
        c1 -> c1 : 写真の未登録チェック
        alt 写真が1枚も未登録
            c1 -> b1 : 催促メッセージ（エラーメッセージ）を表示
        else 写真あり

            == [チェック3] 写真のファイル形式チェック ==
            c1 -> c1 : 写真のファイル形式チェック
            alt ファイル指定形式以外
                c1 -> b1 : エラーメッセージを表示
            else ファイル指定形式内
                c1 --> b1 : チェック成功通知
                b1 -> b1 : 「登録済みの被害情報」項目に\n選択した内容・写真を追加
            end
        end
    end

    == 3. 登録済み情報の削除操作 ==
    alt 利用者が被害写真の削除ボタンをクリック
        a1 -> b1 : 被害写真の削除ボタンをクリック
        b1 -> b1 : 選択中の写真をリストから削除

    else 利用者が被害情報の削除ボタンをクリック
        a1 -> b1 : 被害情報の削除ボタンをクリック
        b1 -> b1 : 選択された被害情報を削除
    end

    == 4. 「分析開始」押下時の最終チェックと分析遷移 ==
    a1 -> b1 : 「建物全体の状態について」の質問への回答を選択し、\n「分析開始」ボタンをクリック
    b1 -> c1 : POST /damage/input (分析開始リクエスト)

    == [チェック4] 被害状況登録チェック ==
    c1 -> c1 : 被害状況登録チェック
    alt 1件も登録されてない（リストが空）
        c1 -> b1 : 催促メッセージ（エラーメッセージ）を表示
    else 1件以上登録されている

        == [チェック5] 被害写真上限チェック ==
        c1 -> c1 : 被害写真上限チェック
        alt 上限枚数を超えている
            c1 -> b1 : 上限超過メッセージを表示
        else 上限枚数を超えていない

            == 5. AI分析への遷移 ==
            note over c1 : シーケンス\n「被害状況を入力する2 (登録／分析開始)」へ
        end
    end

    == ex. 「戻る」押下時の処理 ==
    a1 -> b1 : 利用者が戻るボタンをクリック
    b1 -> c1 : POST
    c1 -> b4 : building_input.htmlへ
    note over b4 : ユースケース終了

@enduml

@startuml 被害状況を入力する_2
    title 被害状況を入力する2 (登録／分析開始)

    actor "利用者" as a1
    boundary "analysis_input_damage.html" as b1
    control "AnalysisInputView" as c1
    control "PhotoStorageService" as s1
    entity "S3" as S3
    entity "DamageReport" as e1
    entity "DamageLocation" as e2
    entity "DamagePhoto" as e3
    control "AnalysisView" as c2

    == 5. AI分析への遷移 ==
    note over c1 : シーケンス\n「被害状況を入力する1 (情報入力)」から
    loop 登録された被害写真の枚数分
        c1 -> s1 : upload_photo()
        s1 -> S3 : 写真をアップロード
        S3 --> s1 : アップロード結果
        s1 --> c1 : s3_object_key
    end
    alt 写真のアップロードに失敗
        c1 --> b1 : エラーメッセージを表示し\n再アップロードを促す
    else 写真のアップロードに成功
        alt ログインしている場合
            c1 -> c1 : sessionからbuilding_idを取得し\n建物の所有者を確認
            c1 -> e1 : 被害状況を登録
            e1 --> c1 : report_id

            loop 登録された被害箇所の件数分
                c1 -> e2 : 被害箇所を登録
                e2 --> c1 : location_id
                loop 被害箇所に紐づいた被害写真の件数分
                    c1 -> e3 : 写真情報とs3_object_keyを登録
                    e3 --> c1 : 登録完了
                end
            end
            alt DBへの保存に失敗
                loop アップロードした被害写真の枚数分
                    c1 -> s1 : delete_photo(s3_object_key)
                    s1 -> S3 : 写真を削除
                    S3 --> s1 : 削除結果
                    s1 --> c1 : 削除完了
                    c1 --> b1 : エラーメッセージ表示
                end
            else DBへの保存に成功
                c1 -> c1 : sessionにreport_idを保存
                c1 -> c2 : AI分析を開始
                note over c2 : ユースケース\n「被害状況をAI分析する」へ
            end
        else ログインしていない場合
            c1 -> c1 : サーバー側の一時セッションに\ns3_object_keyを関連付けて保存
            c1 -> b1 : 成功レスポンスを返す
            b1 -> b1 : 入力内容をsessionStorageに保存
            b1 -> c2 : AI分析を開始 (Redirect /analysis)
            note over c2 : ユースケース\n「被害状況をAI分析する」へ
        end
    end
@enduml


@startuml 被害状況をAI分析する
    title 被害状況をAI分析する

    actor "利用者" as a1
    boundary "analysis.html" as b1
    control "AnalysisView" as c1
    control "DamageAnalysisService" as s1
    entity "Building" as e1
    entity "DamageReport" as e2
    entity "DamageLocation" as e3
    entity "DamagePhoto" as e4
    entity "S3" as S3
    control "PhotoStorageService" as s2
    control "GeminiService" as s3
    entity "AnalysisHistory" as e5
    boundary "analysis_additional_chat.html" as b2
    boundary "analysis_input_damage.html" as b3
    control "AnalysisInputView" as c2
    boundary "index.html" as b4
    control "IndexView" as c3
    boundary "analysis_result.html" as b5


    == 1. 分析画面の表示とAI分析の開始 ==
    note over c1 : ユースケース\n「被害状況を入力する」から
    c1 -> b1 : analysis.htmlを表示
    b1 -> c1 : AI分析を開始
    c1 -> c1 : 分析に必要な情報を取得
    alt ログインしている
        c1 -> e1 : 建物情報を取得(building_id)
        e1 --> c1 : 建物データ
        c1 -> e2 : 被害状況を取得(report_id)
        e2 --> c1 : 被害状況データ
        c1 -> e3 : 被害箇所を取得(report_id)
        e3 --> c1 : 被害箇所データ
        c1 -> e4 : 被害写真を取得(report_id)
        e4 --> c1 : 被害写真テーブルデータ
        loop 取得できた被害写真データの件数分
            c1 -> s1 : generate_presigned_url(s3_object_key)
            s1 -> S3 : S3の被害写真データを取得
            S3 --> s1 : 取得結果
            s1 --> c1 : 被害写真写真データ
        end
    else ログインしていない
        c1 -> c1 : sessionStorageから入力データを取得
        loop サーバー側の一時セッションに保存されているs3_object_key件数分
        c1 -> s1 :
    end
    c1 -> ai : AI分析を実行

    == 2. AI分析中の分岐処理（タイムアウト / 追加質問 / 完了） ==

    alt 決められた制限時間内にAI分析が完了しなかった場合（タイムアウト）
        ai --> c1 : タイムアウトエラー
        c1 -> c1 : 処理を中断
        c1 -> b1 : エラーメッセージを表示
        c1 -> b1 : 戻るボタンとキャンセルボタンを表示

        alt 利用者が戻るボタンをクリック
            a1 -> b1 : 戻るボタンをクリック
            b1 -> b3 : damage_input.htmlを表示
        else 利用者がキャンセルをクリック
            a1 -> b1 : キャンセルをクリック
            b1 -> b4 : index.htmlを表示
        end

    else AIが、分析に必要な情報が不足していると判断した場合
        ai --> c1 : 追加質問の必要あり
        c1 -> b2 : followup.htmlを表示

    else AI分析完了の場合
        ai --> c1 : AI分析完了

        == 3. ログイン状態による保存先の分岐 ==
        alt ログインしている
            c1 -> e5 : 分析結果の要約を保存
            e5 --> c1 : 保存完了
        else ログアウトしていない
            c1 -> c1 : セッションに分析結果の要約を保存
        end

        == 4. 分析結果画面の表示 ==
        c1 -> b5 : 分析結果と修理費用の目安と\n被害写真のダウンロードリンクを表示
        b5 -> a1 : 分析結果画面を表示
    end

@enduml


@startuml 不足情報の追加質問に回答する
    title 不足情報の追加質問に回答する

    actor "ユーザー" as a1
    boundary "analysis.html" as b1
    boundary "followup.html" as b2
    control "AnalysisView" as c1
    control "ai"

    == 1. 初期表示（前画面からの続き） ==
    b1 -> b2 : 「分析に必要な情報についての質問を表示」

    == 2. 回答の入力とAIによる判定ループ ==
    loop 利用者の回答が不十分な場合
        a1 -> b2 : 質問に対しての回答を入力し\n「回答」ボタンをクリック
        b2 -> c1
        c1 -> ai : 回答をAIに渡す
        alt 利用者の回答が不十分なものであるとAIが判断
            ai -> c1
            c1 -> b2 : ふたたび分析に必要な質問を表示
            b2 -> a1 : 再度の回答入力を求める
        end
    end

    == 3. 回答が十分な場合の処理とAI再分析 ==
    note over c1 : 回答が十分であると判断された場合

    ai -> c1 : AIからの応答を取得
    c1 -> b2 : 回答に対する応答を表示

    b2 -> c1 : AI分析へ遷移（再実行）

@enduml


@startuml 分析結果について質問する
    title 分析結果について質問する

    actor "ユーザー" as a1
    boundary "analysis_result.html / history_detail.html" as b1
    boundary "chat.html" as b2
    control "ChatView" as c1
    control "ai"
    entity "ChatMessage" as e1

    == 1. チャット画面の起動 ==
    a1 -> b1 : 「結果についてチャットボットに質問する」\nリンクをクリック
    b1 -> c1 : GET /chat
    c1 -> b2 : 画面を表示し、チャットボットを利用できる状態にする
    b2 -> a1 : 「分析結果について質問」画面を表示

    == 2. 質問の送信とAI処理 ==
    a1 -> b2 : 質問を入力し、「送信」ボタンをクリック
    b2 -> c1 : POST /chat/message (質問を送信)
    c1 -> ai : 回答をAIに渡す

    == 3. 分析結果の取得と応答判定 ==
    ai -> ai : 分析結果を取得

    alt 分析結果が取得できない
        ai --> c1 : 取得できない（エラー）
        c1 -> c1 : 処理を中断
        c1 -> b2 : エラーメッセージを表示

    else 決められた制限時間内に応答が完了しなかった場合（タイムアウト）
        ai --> c1 : タイムアウト
        c1 -> c1 : 処理を中断
        c1 -> b2 : エラーメッセージを表示

    else 正常に応答が完了した場合
        ai -> ai : AIからの応答を取得
        ai --> c1 : 応答データ

        c1 -> b2 : 応答を表示
        b2 -> a1 : AIの回答を表示

        == 4. ログイン状態による履歴保存の分岐 ==
        c1 -> c1 : ログインチェック

        alt ログイン状態
            c1 -> e1 : チャットを保存
            e1 --> c1 : 保存完了
            c1 -> b2 : チャット履歴に反映
        else ログアウト状態
            note over c1 : チャットは保存せず\nそのまま画面を維持する
        end
    end

@enduml


@startuml 復旧に必要な情報を確認する
    title 復旧に必要な情報を確認する

    actor "ユーザー" as a1
    boundary "任意の画面" as b1
    boundary "recovery_info.html" as b2
    control "RecoveryView" as c1

    == 1. 復旧情報画面の初期表示 ==
    a1 -> b1 : 「復旧情報」または\n「復旧に必要な情報を確認する」リンクをクリック
    b1 -> c1 : GET /recovery
    c1 -> b2 : recovery_info.htmlを表示

    note over b2 : 初期表示として\n「罹災証明書の発行の案内」を表示
    b2 -> a1 : recovery_info.htmlを表示

    == 2. 4つのボタンクリックによる案内切り替え（画面内制御） ==
    alt 「罹災証明書の発行」ボタンをクリック
        a1 -> b2 : 「罹災証明書の発行」ボタンをクリック
        b2 -> b2 : 罹災証明書の発行の案内を表示

    else 「応急修理制度」ボタンをクリック
        a1 -> b2 : 「応急修理制度」ボタンをクリック
        b2 -> b2 : 応急修理制度の案内を表示

    else 「被災者生活再建支援金」ボタンをクリック
        a1 -> b2 : 「被災者生活再建支援金」ボタンをクリック
        b2 -> b2 : 被災者生活再建支援金の案内を表示

    else 「災害時のアドバイス」ボタンをクリック
        a1 -> b2 : 「災害時のアドバイス」ボタンをクリック
        b2 -> b2 : 災害時のアドバイスを表示
    end

    == 3. 案内の確認完了 ==
    note over b2 : いずれの案内を表示した後も\nrecovery_info.htmlを維持する

@enduml


@startuml マイページを確認する
    title マイページを確認する

    actor "ユーザー" as a1
    boundary "任意の画面" as b1
    boundary "mypage.html" as b2
    control "MyPageView" as c1
    entity "Building" as e1
    entity "AnalysisHistory" as e2

    == 1. マイページへのアクセスと建物情報の取得 ==
    a1 -> b1 : 「マイページ」リンクをクリック
    b1 -> c1 : GET /mypage

    c1 -> e1 : 建物情報を取得
    e1 --> c1 : 建物データ

    == 2. 登録建物の有無による分岐 ==
    alt 登録された建物がない場合
        c1 -> c1 : 「登録建物なし」メッセージを設定

    else 登録された建物がある場合
        c1 -> c1 : 登録した建物一覧を表示用に設定
    end

    == 3. 分析履歴の取得と件数による分岐 ==
    c1 -> e2 : 分析履歴を取得
    e2 --> c1 : 分析履歴データ

    alt 分析履歴がない場合
        c1 -> c1 : 「分析履歴なし」メッセージを設定
        c1 -> c1 : 「すべての分析履歴」リンクを非表示に設定

    else 最近の分析履歴がある場合
        c1 -> c1 : 最近の分析履歴を表示用に設定
    end

    == 4. マイページ画面のレンダリング ==
    c1 -> b2 : 設定した内容でmypage.htmlを表示
    b2 -> a1 : マイページ画面を表示

@enduml


